    },
    {
      "@type": "FAQPage",
      "@id": "https://github.com/entercation2021-hue/outerprise-spec#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Outtegration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Outtegration describes detached evidence delivery at an institutional boundary. A producer delivers a package for inspection and the recipient checks it under its own policy. The pattern requires no standing API integration with the recipient. The recipient retains responsibility for access, acceptance, and any later decision."
          }
        },
        {
          "@type": "Question",
          "name": "How does Dual-Receipt bind a decision to an evaluation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The decision issuer and policy evaluator use separate signing roles. The verifier checks the specified bindings between the decision, its receipt and the evaluation, then checks the required signatures and applicable policy. An authorized relying party determines whether the evidence supports action."
          }
        },
        {
          "@type": "Question",
          "name": "What does a transparency receipt establish?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It provides inclusion evidence under the applicable profile and authenticated root. The relying party establishes the service identity, current trust and any required freshness separately."
          }
        },
        {
          "@type": "Question",
          "name": "How do E01–E15 address verification ambiguities?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Pain Point Resolutions draft maps fifteen issues to authored profiles, new proposals, external mechanisms, or uncovered gaps. It preserves four explicit open issues and neither amends nor extends the cited RFCs by itself."
          }
        },
        {
          "@type": "Question",
          "name": "Does a receipt prove the underlying claim is true?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A receipt supplies bounded registration evidence. Source corroboration, authority and the truth of the issuer’s assertion require their own checks."
          }
        },
        {
          "@type": "Question",
          "name": "What does the Handshake bind?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The evaluation references SHA-256 over the complete tagged decision COSE_Sign1 file as delivered. A different signed representation requires a new exact-file binding."
          }
        },
        {
          "@type": "Question",
          "name": "What does the Transaction Attestation Ledger record?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The TAL links presented observations through predecessor digests. Its tip commits to the presented chain within scope. Global completeness and freshness require separate evidence."
          }
        },
        {
          "@type": "Question",
          "name": "What are the Four Gates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Validation, Trust, Engagement and Procurement are distinct institution-controlled gates. An Outer Pilot is a bounded evaluation within Engagement."
          }
        },
        {
          "@type": "Question",
          "name": "What does fail-closed export mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Missing, stale or mismatched required evidence blocks export under the proposed gate policy. The benchmark records a shipped and tested gate as an open assurance gap."
          }
        },
        {
          "@type": "Question",
          "name": "What do PASS, UNAVAILABLE and FAIL mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Report each record under its pinned profile. PASS records a performed, successful check. UNAVAILABLE names a missing prerequisite. FAIL records a check that returned a negative result under the applicable rule."
          }
        },
        {
          "@type": "Question",
          "name": "What does JSON Canonicalization Scheme do?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RFC 8785 defines a reproducible encoding for admissible JSON values. It gives verifiers a consistent byte sequence for hashing or signing under a profile that selects it."
          }
        },
        {
          "@type": "Question",
          "name": "What does COSE_Sign1 sign?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under RFC 9052 a verifier rebuilds the applicable Sig_structure, accounting for protected header bytes, external AAD and the payload. Signer authority comes from the relying party’s trust policy."
          }
        },
        {
          "@type": "Question",
          "name": "What does the benchmark score establish?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The dated management self-assessment records 19 conforming checks and five named gaps out of 24. It includes scope boundaries and design observations and carries no independent assurance conclusion."
          }
        },
        {
          "@type": "Question",
          "name": "Are the vectors real records?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All distributed vectors are synthetic. Test keys are for fixtures only. The expected results apply to the pinned source and do not establish production behavior."
          }
        },
        {
          "@type": "Question",
          "name": "How should I cite a draft or release?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cite the exact Datatracker revision for protocol language and the Zenodo version DOI for archival bytes. Use the all-versions DOI for discovering future Zenodo releases."
          }
        }
      ],
